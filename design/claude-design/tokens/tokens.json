{
  "name": "Pepak Doto",
  "version": "0.1.0",
  "color": {
    "dark": {
      "bg": "#0F0D0A",
      "surface": "#17140F",
      "surface-2": "#211C15",
      "border": "#3A3226",
      "border-strong": "#76634C",
      "fg": "#F2ECDF",
      "muted": "#ADA38F",
      "accent": "#D6A640",
      "accent-fg": "#E4BB5E",
      "on-accent": "#1A1206",
      "accent-soft": "#2A2213",
      "radiant": "#5FC592",
      "dire": "#EE7468",
      "danger": "#F2845C",
      "sogan": "#8A5A36",
      "sogan-deep": "#2E1F14",
      "wedel": "#34466E",
      "wedel-deep": "#182038"
    },
    "light": {
      "bg": "#F4EFE5",
      "surface": "#FBF8F2",
      "surface-2": "#ECE5D6",
      "border": "#D5C9B3",
      "border-strong": "#8F7D62",
      "fg": "#1E1912",
      "muted": "#5F5546",
      "accent": "#C8952E",
      "accent-fg": "#83580F",
      "on-accent": "#1A1206",
      "accent-soft": "#F1E3C2",
      "radiant": "#1A6E44",
      "dire": "#B2362C",
      "danger": "#A3401A",
      "sogan": "#7A4A2A",
      "sogan-deep": "#5C3A22",
      "wedel": "#2F4068",
      "wedel-deep": "#1E2A48"
    }
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px"
  },
  "shadow": {
    "dark": {
      "1": "0 1px 0 0 rgba(0,0,0,.5)",
      "2": "0 10px 24px -14px rgba(0,0,0,.8)",
      "3": "0 24px 48px -20px rgba(0,0,0,.85), 0 0 0 1px #3A3226"
    },
    "light": {
      "1": "0 1px 0 0 rgba(58,39,24,.08)",
      "2": "0 10px 24px -14px rgba(58,39,24,.28)",
      "3": "0 24px 48px -20px rgba(58,39,24,.35), 0 0 0 1px #D5C9B3"
    }
  },
  "patternOpacity": {
    "dark": 0.06,
    "light": 0.07
  },
  "font": {
    "display": {
      "family": "Alegreya",
      "weights": [
        500,
        700
      ],
      "italic": [
        500
      ],
      "use": "headings, chapter titles, margin notes (italic)"
    },
    "displaySC": {
      "family": "Alegreya SC",
      "weights": [
        500,
        700
      ],
      "use": "wordmark, chapter labels, index tabs"
    },
    "sans": {
      "family": "Atkinson Hyperlegible Next",
      "weights": [
        400,
        500,
        700
      ],
      "use": "body, UI"
    },
    "mono": {
      "family": "Atkinson Hyperlegible Mono",
      "weights": [
        400,
        500
      ],
      "use": "stats, timers, win rates"
    },
    "javanese": {
      "family": "Noto Sans Javanese",
      "weights": [
        400
      ],
      "use": "decorative accent only"
    }
  },
  "typeScale": {
    "display": {
      "size": "56/48px",
      "line": 1.05,
      "font": "display 700"
    },
    "h1": {
      "size": "40/32px",
      "line": 1.1,
      "font": "display 700"
    },
    "h2": {
      "size": "28/24px",
      "line": 1.2,
      "font": "display 700"
    },
    "h3": {
      "size": "20px",
      "line": 1.3,
      "font": "display 700"
    },
    "body": {
      "size": "16px",
      "line": 1.55,
      "font": "sans 400"
    },
    "small": {
      "size": "14px",
      "line": 1.45,
      "font": "sans 400"
    },
    "label": {
      "size": "12px",
      "line": 1.3,
      "font": "sans 700",
      "tracking": "0.06em",
      "case": "upper"
    },
    "stat": {
      "size": "14-32px",
      "font": "mono 500",
      "features": "tnum"
    }
  },
  "spacing": {
    "base": "4px",
    "scale": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      96
    ]
  }
}