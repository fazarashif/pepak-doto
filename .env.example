# Copy this file to .env.local and fill in what you need.

# Signs the login cookie. Required. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# SteamID64 of the accounts that can open /admin, comma separated.
ADMIN_STEAM_IDS=

# Postgres connection string (Neon in production). Leave empty locally and the
# app uses an embedded database in .data/pglite instead.
DATABASE_URL=

# Hero matchups and synergy (https://stratz.com/api)
STRATZ_TOKEN=

# Optional. Fresher names and avatars at sign-in; OpenDota is used without it.
STEAM_WEB_API_KEY=

# Optional. Raises the OpenDota rate limit.
OPENDOTA_API_KEY=

# Protects /api/cron/daily. Vercel sends it automatically once it's set there.
CRON_SECRET=
